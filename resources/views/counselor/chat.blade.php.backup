<script>
window.authUserId = {{ auth()->id() }};
window.authUserInitial = @json(substr(auth()->user()->name, 0, 1));
</script>

<script src="/js/counselor-chat.js"></script>

<script>
/*
|--------------------------------------------------------------------------
| UI-only helpers
|--------------------------------------------------------------------------
| These do not replace the existing chat logic. They only improve the new
| layout and protect the /counselor/messages empty state.
*/
(function () {
    const root = document.querySelector('.chat-container');
    const search = document.getElementById('studentSearch');

    if (search) {
        search.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();

            document.querySelectorAll('.student-item').forEach(function (item) {
                const text = (item.getAttribute('data-search-text') || item.textContent || '').toLowerCase();
                item.style.display = !query || text.includes(query) ? '' : 'none';
            });
        });
    }

    document.querySelectorAll('.student-item').forEach(function (item) {
        item.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                item.click();
            }
        });
    });

    /*
     * On /counselor/messages there must be NO fake selected student.
     * This runs after the existing external script and restores the intended
     * empty state if there is no server-provided preselection.
     */
    window.addEventListener('load', function () {
        if (!root) return;

        const preselected = root.getAttribute('data-preselect-student');

        if (!preselected) {
            document.querySelectorAll('.student-item.active').forEach(function (item) {
                item.classList.remove('active');
            });

            const header = document.getElementById('chatHeader');
            const messages = document.getElementById('messagesArea');
            const input = document.getElementById('inputArea');
            const empty = document.getElementById('emptyState');
            const studentId = document.getElementById('studentId');

            if (header) header.style.display = 'none';
            if (messages) {
                messages.style.display = 'none';
                messages.innerHTML = '';
            }
            if (input) input.style.display = 'none';
            if (empty) empty.style.display = 'flex';
            if (studentId) studentId.value = '';
        }
    });
})();
</script>
@endsection
