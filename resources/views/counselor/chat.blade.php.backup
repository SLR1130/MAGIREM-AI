<style>
:root{
    --mc-forest:#103F32;
    --mc-emerald:#236B55;
    --mc-gold:#F4C84E;
    --mc-mint:#E6F1EB;
    --mc-mint-2:#F0F7F3;
    --mc-ivory:#F8FAF7;
    --mc-white:#FFFFFF;
    --mc-text:#263A33;
    --mc-muted:#6F8179;
    --mc-border:#DCE7E1;
    --mc-border-strong:#CBDDD4;
    --mc-soft:#F4F8F5;
    --mc-danger:#B94A48;
    --mc-shadow:0 18px 45px rgba(16,63,50,.08);
    --mc-shadow-soft:0 8px 24px rgba(16,63,50,.06);
}

/* Page */
.mc-messages-page{
    width:100%;
    padding:24px clamp(20px,2.2vw,34px) 30px;
    color:var(--mc-text);
}

.mc-page-head{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:24px;
    margin-bottom:18px;
}

.mc-eyebrow{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--mc-emerald);
    font-size:12px;
    font-weight:800;
    letter-spacing:.12em;
    text-transform:uppercase;
    margin-bottom:8px;
}

.mc-eyebrow::before{
    content:"";
    width:22px;
    height:2px;
    border-radius:999px;
    background:var(--mc-gold);
}

.mc-page-title{
    margin:0;
    color:var(--mc-forest);
    font-size:clamp(34px,3.2vw,52px);
    line-height:.98;
    letter-spacing:-.045em;
    font-weight:800;
}

.mc-page-subtitle{
    margin:10px 0 0;
    max-width:720px;
    color:var(--mc-muted);
    font-size:14px;
    line-height:1.65;
}

.mc-head-meta{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 13px;
    border:1px solid var(--mc-border);
    border-radius:999px;
    background:rgba(255,255,255,.82);
    color:var(--mc-forest);
    font-size:12px;
    font-weight:700;
    box-shadow:0 4px 14px rgba(16,63,50,.04);
}

.mc-head-meta-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#2CB67D;
    box-shadow:0 0 0 4px rgba(44,182,125,.10);
}

/* Main workspace - intentionally TWO columns.
   The old page reserved a hidden 3rd column, causing the large blank space. */
.chat-container{
    width:100%;
    display:grid !important;
    grid-template-columns:320px minmax(0,1fr) !important;
    gap:0 !important;
    min-height:610px;
    height:min(760px, calc(100dvh - 232px));
    background:var(--mc-white);
    border:1px solid var(--mc-border);
    border-radius:20px;
    overflow:hidden;
    box-shadow:var(--mc-shadow);
    position:relative;
}

/* Conversation rail */
.sidebar-left{
    min-width:0;
    display:flex;
    flex-direction:column;
    background:#FBFDFC;
    border-right:1px solid var(--mc-border);
    overflow:hidden;
}

.sidebar-header{
    padding:20px 20px 16px;
    background:#FBFDFC;
    color:var(--mc-text);
    border-bottom:1px solid var(--mc-border);
}

.mc-conversation-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:14px;
}

.mc-conversation-title-wrap{
    display:flex;
    align-items:center;
    gap:10px;
}

.mc-conversation-icon{
    width:34px;
    height:34px;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--mc-forest);
    background:var(--mc-mint);
    flex:0 0 auto;
}

.mc-conversation-icon svg{
    width:18px;
    height:18px;
}

.mc-conversation-title{
    margin:0;
    color:var(--mc-forest);
    font-size:16px;
    font-weight:800;
    letter-spacing:-.015em;
}

.mc-count{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:26px;
    height:26px;
    padding:0 8px;
    border:1px solid var(--mc-border);
    border-radius:999px;
    background:white;
    color:var(--mc-muted);
    font-size:11px;
    font-weight:800;
}

.mc-search{
    position:relative;
}

.mc-search svg{
    position:absolute;
    left:12px;
    top:50%;
    transform:translateY(-50%);
    width:16px;
    height:16px;
    color:#8EA098;
    pointer-events:none;
}

.mc-search input{
    width:100%;
    height:42px;
    padding:0 13px 0 38px;
    border:1px solid var(--mc-border);
    border-radius:12px;
    background:white;
    color:var(--mc-text);
    font:inherit;
    font-size:13px;
    outline:none;
    transition:.2s ease;
}

.mc-search input::placeholder{ color:#9AA9A2; }
.mc-search input:focus{
    border-color:rgba(35,107,85,.55);
    box-shadow:0 0 0 4px rgba(35,107,85,.08);
}

.student-list{
    flex:1;
    min-height:0;
    overflow-y:auto;
    padding:12px;
    scrollbar-width:thin;
    scrollbar-color:#C9D9D1 transparent;
}

.student-item{
    width:100%;
    min-width:0;
    padding:13px 12px;
    margin:0 0 7px;
    border:1px solid transparent;
    border-radius:14px;
    background:transparent;
    color:var(--mc-text);
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:11px;
    position:relative;
    transition:background .18s ease,border-color .18s ease,box-shadow .18s ease,transform .18s ease;
}

.student-item:hover{
    background:var(--mc-mint-2);
    border-color:#E0ECE6;
}

.student-item.active{
    background:var(--mc-mint);
    border-color:#CFE2D8;
    box-shadow:inset 3px 0 0 var(--mc-forest);
}

.student-avatar{
    width:42px;
    height:42px;
    border-radius:13px;
    background:var(--mc-forest);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:14px;
    font-weight:800;
    flex:0 0 auto;
    box-shadow:0 5px 14px rgba(16,63,50,.12);
}

.student-item.active .student-avatar{
    background:white;
    color:var(--mc-forest);
    border:1px solid #CFE2D8;
    box-shadow:none;
}

.student-info{
    flex:1;
    min-width:0;
}

.student-name{
    margin:0;
    color:var(--mc-forest);
    font-size:13px;
    font-weight:800;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.student-id{
    margin:3px 0 0;
    color:var(--mc-muted);
    font-size:11px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.status-indicator{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#24B47E;
    flex:0 0 auto;
    box-shadow:0 0 0 3px rgba(36,180,126,.10);
}

/* Main chat */
.chat-panel{
    min-width:0;
    display:flex;
    flex-direction:column;
    background:white;
    overflow:hidden;
    position:relative;
}

.chat-header{
    min-height:82px;
    padding:16px 22px;
    display:none;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    background:rgba(255,255,255,.96);
    border-bottom:1px solid var(--mc-border);
    z-index:2;
}

.chat-header-left{
    min-width:0;
    display:flex;
    align-items:center;
    gap:12px;
}

.chat-avatar{
    width:46px;
    height:46px;
    border-radius:14px;
    background:var(--mc-forest);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:15px;
    font-weight:800;
    flex:0 0 auto;
}

.chat-header-info{
    min-width:0;
}

.chat-header-info h3{
    margin:0;
    color:var(--mc-forest);
    font-size:15px;
    font-weight:800;
    letter-spacing:-.01em;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.chat-header-info p{
    margin:4px 0 0;
    color:var(--mc-muted);
    font-size:11.5px;
    display:flex;
    align-items:center;
    gap:6px;
}

.chat-header-info p svg{
    width:14px;
    height:14px;
    color:var(--mc-emerald);
}

.mc-header-actions{
    display:flex;
    align-items:center;
    gap:8px;
}

.mc-header-action{
    height:38px;
    padding:0 12px;
    border:1px solid var(--mc-border);
    border-radius:10px;
    background:white;
    color:var(--mc-forest);
    font:inherit;
    font-size:11px;
    font-weight:800;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:7px;
    transition:.18s ease;
}

.mc-header-action:hover{
    background:var(--mc-mint-2);
    border-color:#CFE2D8;
}

.mc-header-action svg{
    width:15px;
    height:15px;
}

/* Empty state */
.empty-state{
    flex:1;
    min-height:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px;
    background:
        radial-gradient(circle at 50% 38%, rgba(230,241,235,.72), rgba(248,250,247,0) 34%),
        linear-gradient(180deg,#FFFFFF 0%,#FBFDFC 100%);
}

.mc-empty-icon{
    width:70px;
    height:70px;
    border-radius:22px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:18px;
    background:var(--mc-mint);
    color:var(--mc-forest);
    box-shadow:0 12px 30px rgba(16,63,50,.07);
}

.mc-empty-icon svg{
    width:30px;
    height:30px;
}

.mc-empty-title{
    margin:0;
    color:var(--mc-forest);
    font-size:20px;
    line-height:1.2;
    font-weight:800;
    letter-spacing:-.025em;
}

.mc-empty-copy{
    max-width:390px;
    margin:8px 0 0;
    color:var(--mc-muted);
    font-size:13px;
    line-height:1.7;
}

/* Messages */
.messages-area{
    flex:1;
    min-height:0;
    overflow-y:auto;
    display:none;
    padding:24px clamp(18px,2.5vw,34px);
    background:
        linear-gradient(rgba(248,250,247,.92),rgba(248,250,247,.92)),
        radial-gradient(circle at 15% 10%, rgba(230,241,235,.85), transparent 34%);
    scrollbar-width:thin;
    scrollbar-color:#C9D9D1 transparent;
}

.message-bubble{
    display:flex;
    gap:9px;
    margin:0 0 14px;
    animation:mcMessageIn .22s ease both;
}

.message-bubble.own{
    justify-content:flex-end;
}

.bubble-content{
    display:flex;
    gap:9px;
    max-width:min(72%,680px);
    align-items:flex-end;
}

.message-bubble.own .bubble-content{
    flex-direction:row-reverse;
}

.bubble-avatar{
    width:31px;
    height:31px;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 auto;
    font-size:10px;
    font-weight:800;
}

.bubble-avatar.own{
    background:var(--mc-forest);
    color:white;
}

.bubble-avatar.other{
    background:var(--mc-mint);
    color:var(--mc-forest);
    border:1px solid #D5E7DE;
}

.bubble-text{
    padding:10px 13px 8px;
    border-radius:16px;
    font-size:13px;
    line-height:1.55;
    word-break:break-word;
    box-shadow:0 4px 14px rgba(16,63,50,.04);
}

.bubble-text.own{
    background:var(--mc-forest);
    color:white;
    border-radius:16px 16px 5px 16px;
}

.bubble-text.other{
    background:white;
    color:var(--mc-text);
    border:1px solid var(--mc-border);
    border-radius:16px 16px 16px 5px;
}

.bubble-meta{
    margin-top:5px;
    display:flex;
    align-items:center;
    gap:5px;
    font-size:9.5px;
}

.bubble-text.own .bubble-meta{ color:rgba(255,255,255,.68); }
.bubble-text.other .bubble-meta{ color:#8A9A93; }
.bubble-meta svg{ width:11px;height:11px; }

@keyframes mcMessageIn{
    from{opacity:0;transform:translateY(5px)}
    to{opacity:1;transform:translateY(0)}
}

/* Composer */
.input-area{
    display:none;
    padding:13px 16px 15px;
    background:white;
    border-top:1px solid var(--mc-border);
    position:relative;
}

.input-toolbar{
    display:flex;
    align-items:center;
    gap:7px;
    margin-bottom:9px;
}

.toolbar-btn{
    width:36px;
    height:36px;
    border:1px solid var(--mc-border);
    border-radius:10px;
    background:white;
    color:var(--mc-forest);
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    transition:.18s ease;
}

.toolbar-btn:hover{
    background:var(--mc-mint-2);
    border-color:#CFE2D8;
}

.toolbar-btn svg{
    width:17px;
    height:17px;
}

#filePreview{
    margin:0 0 9px !important;
    padding:9px 11px !important;
    border:1px solid var(--mc-border) !important;
    background:var(--mc-mint-2) !important;
    border-radius:10px !important;
    color:var(--mc-forest) !important;
}

.message-form{
    display:flex;
    align-items:flex-end;
    gap:10px;
}

.message-form textarea{
    flex:1;
    min-height:48px;
    max-height:140px;
    resize:none;
    padding:13px 14px;
    border:1px solid var(--mc-border-strong);
    border-radius:14px;
    background:#FBFDFC;
    color:var(--mc-text);
    font:inherit;
    font-size:13px;
    line-height:1.5;
    outline:none;
    transition:.18s ease;
}

.message-form textarea::placeholder{ color:#95A49D; }

.message-form textarea:focus{
    background:white;
    border-color:rgba(35,107,85,.58);
    box-shadow:0 0 0 4px rgba(35,107,85,.08);
}

.send-btn{
    height:48px;
    min-width:104px;
    padding:0 17px;
    border:0;
    border-radius:13px;
    background:var(--mc-forest);
    color:white;
    font:inherit;
    font-size:12px;
    font-weight:800;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    cursor:pointer;
    transition:transform .18s ease,background .18s ease,box-shadow .18s ease;
    box-shadow:0 8px 20px rgba(16,63,50,.14);
}

.send-btn:hover{
    background:var(--mc-emerald);
    transform:translateY(-1px);
    box-shadow:0 10px 24px rgba(16,63,50,.18);
}

.send-btn svg{
    width:16px;
    height:16px;
}

/* Emoji picker */
#emojiPicker{
    position:absolute !important;
    left:16px !important;
    bottom:108px !important;
    width:min(360px,calc(100% - 32px));
    margin:0 !important;
    padding:12px !important;
    border:1px solid var(--mc-border) !important;
    border-radius:14px !important;
    background:white !important;
    box-shadow:0 18px 45px rgba(16,63,50,.14) !important;
    z-index:50 !important;
}

#emojiPicker > div:first-child{
    display:grid !important;
    grid-template-columns:repeat(8,1fr) !important;
    gap:4px !important;
}

#emojiPicker button{
    min-width:0;
    padding:6px !important;
    border-radius:8px !important;
    transition:.14s ease !important;
}

#emojiPicker button:hover{
    background:var(--mc-mint-2) !important;
    transform:scale(1.08) !important;
}

/* Keep the old right-panel DOM for JS compatibility, but DO NOT reserve a grid column. */
.sidebar-right{
    display:none !important;
}

/* Image modal */
.image-modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:9999;
    align-items:center;
    justify-content:center;
    padding:30px;
    background:rgba(10,30,24,.92);
    backdrop-filter:blur(7px);
}

.image-modal.active{ display:flex; }

.image-modal-content{
    max-width:min(1000px,92vw);
    max-height:86vh;
}

.image-modal-content img{
    display:block;
    max-width:100%;
    max-height:82vh;
    border-radius:16px;
    box-shadow:0 24px 60px rgba(0,0,0,.35);
}

.image-modal-back{
    position:absolute;
    top:22px;
    left:22px;
    height:42px;
    padding:0 15px;
    border:1px solid rgba(255,255,255,.18);
    border-radius:11px;
    background:rgba(16,63,50,.92);
    color:white;
    font:inherit;
    font-size:12px;
    font-weight:800;
    display:flex;
    align-items:center;
    gap:7px;
    cursor:pointer;
}

.image-modal-back svg{width:16px;height:16px}

/* Responsive */
@media (max-width:1100px){
    .chat-container{
        grid-template-columns:280px minmax(0,1fr) !important;
    }
}

@media (max-width:820px){
    .mc-messages-page{ padding:16px; }
    .mc-page-head{ align-items:flex-start; flex-direction:column; }
    .mc-head-meta{ display:none; }
    .chat-container{
        height:auto;
        min-height:640px;
        grid-template-columns:1fr !important;
        border-radius:16px;
    }
    .sidebar-left{
        max-height:260px;
        border-right:0;
        border-bottom:1px solid var(--mc-border);
    }
    .student-list{
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:7px;
    }
    .student-item{ margin:0; }
    .bubble-content{ max-width:88%; }
}

@media (max-width:560px){
    .student-list{ grid-template-columns:1fr; }
    .chat-header{ padding:13px 14px; }
    .mc-header-actions{ display:none; }
    .messages-area{ padding:18px 12px; }
    .input-area{ padding:11px 12px 13px; }
    .message-form{ gap:7px; }
    .send-btn{
        min-width:48px;
        width:48px;
        padding:0;
        font-size:0;
    }
    .send-btn svg{ width:18px;height:18px; }
}
