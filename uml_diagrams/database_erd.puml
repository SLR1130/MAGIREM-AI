@startuml MinsuanScore_Database_ERD
!theme plain
title MinsuanScore AI - Compressed Database Schema (Academic Paper)

entity "compressed_users" as users {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(255)
  * email : VARCHAR(255) <<UK>>
  * password : VARCHAR(255)
  * role : ENUM(student,counselor,admin)
  student_id : VARCHAR(50) <<UK>>
  program : VARCHAR(255)
  year_level : VARCHAR(50)
  is_active : BOOLEAN
  privacy_settings : JSON
  notification_preferences : JSON
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "compressed_emotional_data" as emotional {
  * id : BIGINT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  session_id : VARCHAR(255)
  * entry_type : ENUM(journal,ai_chat,mood_checkin)
  * content : TEXT
  ai_response : TEXT
  detected_emotion : VARCHAR(50)
  confidence_score : DECIMAL(5,2)
  crisis_level : ENUM(none,low,moderate,high,critical)
  needs_counselor : BOOLEAN
  is_anonymous : BOOLEAN
  metadata : JSON
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "compressed_counseling_services" as counseling {
  * id : BIGINT <<PK>>
  * student_id : BIGINT <<FK>>
  counselor_id : BIGINT <<FK>>
  --
  * service_type : ENUM(appointment,message,alert,crisis)
  category : ENUM(academic,personal,crisis,general)
  title : VARCHAR(255)
  description : TEXT
  message_content : TEXT
  status : ENUM(pending,confirmed,completed,cancelled,resolved)
  priority : ENUM(low,medium,high,critical)
  scheduled_at : TIMESTAMP
  resolved_at : TIMESTAMP
  attachments : JSON
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "compressed_mental_health_monitoring" as monitoring {
  * id : BIGINT <<PK>>
  * user_id : BIGINT <<FK>>
  --
  * monitoring_type : ENUM(mood,wellbeing,trend,pattern,alert)
  * date : DATE
  mood_score : INT(1-10)
  stress_level : INT(1-10)
  anxiety_level : INT(1-10)
  emotional_stability : INT(1-10)
  sleep_quality : INT(1-10)
  social_connection : INT(1-10)
  academic_performance : INT(1-10)
  overall_wellbeing : DECIMAL(4,2)
  trend_direction : ENUM(improving,stable,declining)
  alert_triggered : BOOLEAN
  pattern_data : JSON
  notes : TEXT
  created_at : TIMESTAMP
}

entity "compressed_support_resources" as resources {
  * id : BIGINT <<PK>>
  created_by : BIGINT <<FK>>
  --
  * resource_type : ENUM(article,strategy,hotline,prompt,community,activity)
  * category : ENUM(coping,emergency,reflection,peer_support,educational)
  * title : VARCHAR(255)
  description : TEXT
  content : LONGTEXT
  contact_info : VARCHAR(255)
  difficulty_level : ENUM(beginner,intermediate,advanced)
  target_emotion : VARCHAR(100)
  is_active : BOOLEAN
  usage_count : INT
  effectiveness_rating : DECIMAL(3,2)
  metadata : JSON
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "compressed_system_analytics" as analytics {
  * id : BIGINT <<PK>>
  user_id : BIGINT <<FK>>
  --
  * analytics_type : ENUM(assessment,evaluation,ml_model,usage,reminder)
  assessment_category : VARCHAR(100)
  questions : JSON
  responses : JSON
  calculated_scores : JSON
  model_version : VARCHAR(50)
  model_metrics : JSON
  system_rating : DECIMAL(3,2)
  feedback_text : TEXT
  usage_metrics : JSON
  metadata : JSON
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' Relationships
users ||--o{ emotional : "has many"
users ||--o{ counseling : "student"
users ||--o{ counseling : "counselor"
users ||--o{ monitoring : "tracks"
users ||--o{ resources : "creates"
users ||--o{ analytics : "generates"

note right of users : "Central user management\\nwith role-based access"
note right of emotional : "AI conversations &\\nemotion analysis data"
note right of counseling : "Professional support\\n& crisis management"
note right of monitoring : "Mental health tracking\\n& pattern detection"
note right of resources : "Educational content\\n& coping strategies"
note right of analytics : "System performance\\n& user assessments"

@enduml