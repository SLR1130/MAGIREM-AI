APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emotional_aware_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Native Laravel registration is fail-closed. Enable only after institutional
# privacy contact, retention policy, and independent reviewer process are approved.
NATIVE_REGISTRATION_ENABLED=false
# Empty means no account can access applicant records. Add only explicitly
# authorized Guidance Office administrator IDs, comma-separated.
ACCOUNT_VERIFICATION_REVIEWER_IDS=

# Guidance review and privacy settings remain unapproved until the university
# supplies/approves them. Do not enable registration using placeholder values.
ACCOUNT_VERIFICATION_REVIEWER_AUTHORIZATION_APPROVED=false
ACCOUNT_INVITATION_TTL_HOURS=24
ACCOUNT_VERIFICATION_PRIVACY_NOTICE_APPROVED=false
ACCOUNT_VERIFICATION_PRIVACY_NOTICE_VERSION=
ACCOUNT_VERIFICATION_PRIVACY_NOTICE_TEXT=
ACCOUNT_VERIFICATION_PRIVACY_CONTACT=
ACCOUNT_VERIFICATION_RETENTION_POLICY_APPROVED=false
ACCOUNT_VERIFICATION_RETENTION_POLICY_VERSION=
ACCOUNT_VERIFICATION_RETENTION_SCHEDULE=
ACCOUNT_VERIFICATION_ID_RETENTION_DAYS_AFTER_REVIEW=
# Comma-separated approved terminal application statuses only:
# approved,rejected,suspended (leave blank until the institution decides).
ACCOUNT_VERIFICATION_ID_RETENTION_STATUSES=
ACCOUNT_VERIFICATION_ID_RETENTION_ENFORCEMENT_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ML Configuration
ML_DETECTION_ENABLED=true
ML_SERVER_URL=http://localhost:5000
MINDCARE_ML_API_URL=http://127.0.0.1:5000
MINDCARE_CHAT_CONNECT_TIMEOUT=5
MINDCARE_CHAT_REQUEST_TIMEOUT=180
MINDCARE_CHAT_BROWSER_TIMEOUT_MS=210000
MINDCARE_CHAT_RETRY_ATTEMPTS=1
MINDCARE_CHAT_RETRY_DELAY_MS=350
MINDCARE_CHAT_IDEMPOTENCY_TTL_SECONDS=900
MINDCARE_OLLAMA_CONNECT_TIMEOUT=5
# This must stay below Laravel's 180-second request budget.
MINDCARE_OLLAMA_READ_TIMEOUT=150
MINDCARE_OLLAMA_KEEP_ALIVE=10m
# Shared SQLite lease queue: applies across local Flask worker processes.
MINDCARE_GPU_MAX_CONCURRENT=1
MINDCARE_GPU_QUEUE_LIMIT=2
MINDCARE_GPU_QUEUE_WAIT_SECONDS=20
MINDCARE_GPU_LEASE_SECONDS=170
MINDCARE_GPU_QUEUE_POLL_SECONDS=0.20
# Optional absolute path; default is ml_service/runtime/gpu-inference-queue.db.
MINDCARE_GPU_QUEUE_DB=
PYTHON_COMMAND=python

# Dedicated local Laravel-to-Flask crisis inference bridge (not Phase 4A memory auth).
MINDCARE_INFERENCE_BRIDGE_SECRET=
MINDCARE_INFERENCE_BRIDGE_URL=http://127.0.0.1:5000
MINDCARE_INFERENCE_BRIDGE_CONNECT_TIMEOUT=5
MINDCARE_INFERENCE_BRIDGE_TIMEOUT=100

# Keep cross-session memory authorization disabled until signed consent is verified.
MINDCARE_PHASE4A_AUTH_ENABLED=false
# Phase 6 detailed Gemma interpretation is opt-in for a local, non-persisting pilot.
MINDCARE_DETAILED_EMOTION_SHADOW_ENABLED=false
# Separate operator acknowledgement; keep false unless a synthetic pilot is approved.
MINDCARE_DETAILED_EMOTION_SHADOW_APPROVED=false
# Finite Gemma shadow timeout; keep below the Laravel chat request budget.
MINDCARE_DETAILED_EMOTION_SHADOW_TIMEOUT=15
# Shadow labels are not persisted or included in Admin aggregates by default.
MINDCARE_DETAILED_EMOTION_SHADOW_PERSIST=false
MINDCARE_DETAILED_EMOTION_SHADOW_ADMIN_ENABLED=false
# Local-only response-quality pilot; require a synthetic account id and keep disabled by default.
MINDCARE_DETAILED_EMOTION_RESPONSE_PILOT_ENABLED=false
MINDCARE_DETAILED_EMOTION_RESPONSE_PILOT_APPROVED=false
MINDCARE_DETAILED_EMOTION_RESPONSE_PILOT_ACCOUNT_ID=

# Optional student-opt-in wellness resource video discovery (official YouTube Data API v3).
WELLNESS_YOUTUBE_ENABLED=true
YOUTUBE_DATA_API_KEY=
WELLNESS_YOUTUBE_CACHE_TTL=21600
WELLNESS_YOUTUBE_RATE_LIMIT=10
